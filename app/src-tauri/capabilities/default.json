{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: run the core sidecar (only with the rpc argument), pick folders and files, open Steam links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/addonstudio-core",
          "sidecar": true,
          "args": ["rpc"]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://steamcommunity.com/*" },
        { "url": "steam://*" }
      ]
    }
  ]
}
