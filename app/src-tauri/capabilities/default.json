{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: talk to the embedded core (app commands core_spawn/core_write/core_kill), pick folders and files, open Steam links.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://steamcommunity.com/*"
        },
        {
          "url": "steam://*"
        }
      ]
    }
  ]
}
