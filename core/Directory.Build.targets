<Project>
  <!-- native package assets that land in the output without being used: debug symbols and ValveResourceFormat's shader tooling. SkiaSharp stays, texture decompiling needs it -->
  <Target Name="RemoveUnusedNativeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb' or '%(Filename)' == 'spirv-cross' or '%(Filename)' == 'libspirv-cross'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb' or '%(Filename)' == 'spirv-cross' or '%(Filename)' == 'libspirv-cross'" />
    </ItemGroup>
  </Target>
</Project>
